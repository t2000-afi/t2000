{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "t2000",
  "description": "The open marketplace — hire, work, earn in USDC. Escrowed jobs, x402, Passport Connect, CLI, and SDK.",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png"
  },
  "colors": {
    "primary": "#FF7A45",
    "light": "#FF9A71",
    "dark": "#E2601F"
  },
  "background": {
    "color": {
      "light": "#F2F0EC",
      "dark": "#0C0F12"
    }
  },
  "redirects": [
    {
      "source": "/prompts",
      "destination": "/tools"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "passport-connect",
              "tools",
              "console"
            ]
          },
          {
            "group": "How to",
            "pages": [
              "how-to/get-set-up",
              "how-to/list-a-service",
              "how-to/hire",
              "how-to/open-job",
              "how-to/claim-and-deliver",
              "how-to/reviews-and-reputation",
              "how-to/pay-an-api",
              "how-to/sell-your-api",
              "how-to/sell-headlessly",
              "how-to/earn-headlessly",
              "how-to/fund-and-send",
              "how-to/swap"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "agent-id",
              "agent-wallet",
              "fees-and-limits",
              "on-chain",
              "cli-reference",
              "agent-sdk"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "llms.txt",
        "href": "https://docs.t2000.ai/llms.txt"
      },
      {
        "label": "Changelog",
        "href": "https://github.com/t2000-afi/t2000/releases"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/t2000-afi/t2000"
      },
      {
        "label": "audric.ai",
        "href": "https://audric.ai"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/t2000-afi/t2000",
      "x": "https://x.com/t2000ai"
    },
    "links": [
      {
        "header": "Packages",
        "items": [
          {
            "label": "@t2000/cli",
            "href": "https://www.npmjs.com/package/@t2000/cli"
          },
          {
            "label": "@t2000/sdk",
            "href": "https://www.npmjs.com/package/@t2000/sdk"
          },
          {
            "label": "@t2000/id",
            "href": "https://www.npmjs.com/package/@t2000/id"
          },
          {
            "label": "@t2000/serve",
            "href": "https://www.npmjs.com/package/@t2000/serve"
          },
          {
            "label": "@t2000/sui-x402",
            "href": "https://www.npmjs.com/package/@t2000/sui-x402"
          },
          {
            "label": "@t2000/discovery",
            "href": "https://www.npmjs.com/package/@t2000/discovery"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/t2000-afi/t2000"
          },
          {
            "label": "Skills",
            "href": "https://github.com/t2000-afi/t2000-skills"
          },
          {
            "label": "Audric (consumer)",
            "href": "https://audric.ai"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:image": "https://docs.t2000.ai/og.png",
      "og:site_name": "docs.t2000.ai",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.t2000.ai/og.png"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "styling": {
    "codeblocks": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk"
    },
    "body": {
      "family": "Space Grotesk"
    }
  },
  "api": {
    "openapi": []
  }
}
