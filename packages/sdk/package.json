{
  "name": "@t2000/sdk",
  "version": "11.7.0",
  "engines": {
    "node": ">=20"
  },
  "description": "TypeScript SDK for Agent Wallets on Sui — gasless USDC + USDsui transfers, Cetus swap routing, NAVI lending (programmatic), MPP paid API access, zkLogin compatible.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "sui",
    "wallet",
    "ai",
    "agent",
    "sdk",
    "usdc",
    "usdsui",
    "gasless",
    "cetus",
    "navi",
    "zklogin"
  ],
  "author": "t2000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t2000-afi/t2000.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://t2000.ai",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:smoke": "SMOKE=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cetusprotocol/aggregator-sdk": "^1.4.8",
    "@mysten/payment-kit": "^0.1.6",
    "@mysten/sui": "^2.17.0",
    "@mysten/suins": "^1.1.1",
    "@mysten/zklogin": "^0.8.1",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@phala/dcap-qvl": "^0.5.2",
    "@t2000/sui-x402": "workspace:*",
    "bn.js": "^5.2.1",
    "eventemitter3": "^5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20",
    "eslint": "^9",
    "tsup": "^8",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3"
  },
  "license": "MIT"
}
